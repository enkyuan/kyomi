{
  "name": "@kyomi/ui",
  "version": "0.1.0",
  "description": "Shared Kyomi React UI primitives.",
  "repository": {
    "type": "git",
    "url": "https://github.com/enkyuan/kyomi.git",
    "directory": "packages/ui"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./lib/utils": "./src/lib/utils.ts",
    "./checkbox": "./src/checkbox/index.tsx",
    "./checkbox/group": "./src/checkbox/group.tsx",
    "./checkbox-group": "./src/checkbox/group.tsx",
    "./favicon": "./src/favicon.tsx",
    "./hooks/use-media-query": "./src/hooks/use-media-query.ts",
    "./hooks/use-pretext": "./src/hooks/use-pretext.ts",
    "./icons": "./src/icons/index.tsx",
    "./icons/*": "./src/icons/*.tsx",
    "./input": "./src/input/index.tsx",
    "./input/group": "./src/input/group.tsx",
    "./input/otp": "./src/input/otp.tsx",
    "./input-group": "./src/input/group.tsx",
    "./input-otp": "./src/input/otp.tsx",
    "./slider": "./src/slider/index.ts",
    "./sidebar": "./src/sidebar/index.ts",
    "./sidebar/mode-animated-text": "./src/sidebar/components/mode-text.tsx",
    "./sidebar/mode-text": "./src/sidebar/components/mode-text.tsx",
    "./sidebar/reader-focus": "./src/sidebar/state/reader-focus.tsx",
    "./*": "./src/*.tsx",
    "./*.ts": "./src/*.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@chenglou/pretext": "^0.0.4",
    "@mingcute/react": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "input-otp": "^1.4.2",
    "motion": "^12.38.0",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
