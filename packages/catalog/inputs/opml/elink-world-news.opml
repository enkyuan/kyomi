            <outline type="rss" text="The Northern Star" title="The Northern Star" xmlUrl="https://www.northernstar.com.au/feeds/rss/homepage/" htmlUrl="http://northernstar.com.au" description="The Northern Star is the premier news organization of the northern Australian region." />
