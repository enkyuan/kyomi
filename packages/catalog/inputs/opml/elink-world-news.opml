    <body>
        <outline text="US Based RSS News Feeds" title="US Based RSS News Feeds">
            <outline type="rss" text="CNN" title="CNN" xmlUrl="http://rss.cnn.com/rss/cnn_topstories.rss" htmlUrl="http://us.cnn.com" description="CNN News is one of the leading giants in online news &amp; information that seeks to inform, empower, engage the world with top news headlines." />
            <outline type="rss" text="The New York Times" title="The New York Times" xmlUrl="https://archive.nytimes.com/www.nytimes.com/services/xml/rss/index.html" htmlUrl="http://nytimes.com" description="The New York Times is a renowned American newspaper with worldwide readership and influence." />
            <outline type="rss" text="USA TODAY" title="USA TODAY" xmlUrl="http://rssfeeds.usatoday.com/UsatodaycomNation-TopStories" htmlUrl="http://usatoday.com" description="USATODAY.com is a celebrated news &amp; information blog providing readers with breaking news on sports, weather, travel, money, life, technology." />
            <outline type="rss" text="NBC News" title="NBC News" xmlUrl="http://www.nbcnews.com/id/6257883/t/press-release/" htmlUrl="http://nbcnews.com" description="NBCNews.com features content from different NBC shows along with wire and original reporting of all the current headlines." />
            <outline type="rss" text="The Washington Times" title="The Washington Times" xmlUrl="https://www.washingtontimes.com/feeds/" htmlUrl="http://washingtontimes.com" description="The Washington Times is famous for its thorough coverage of politics and hard-hitting investigative reporting." />
            <outline type="rss" text="The Huffington Post" title="The Huffington Post" xmlUrl="https://www.huffingtonpost.in/news/rss/" htmlUrl="http://huffpost.com" description="HuffPost is a popular American news aggregator &amp; website, with international and national editions of everyday news feeds." />
        </outline>
        <outline text="Australia Based RSS News Feeds" title="Australia Based RSS News Feeds">
            <outline type="rss" text="ABC Australia" title="ABC Australia" xmlUrl="https://www.abc.net.au/news/rural/rss/" htmlUrl="http://abc.net.au/news" description="ABC News is a local news service in Australia operated by the Current and News Affairs division of the Australian Broadcasting Corporation." />
            <outline type="rss" text="The Age" title="The Age" xmlUrl="https://www.theage.com.au/rssheadlines" htmlUrl="http://theage.com.au" description="The Age is an Australian daily newspaper published in Melbourne offering fine news coverage from across the country." />
            <outline type="rss" text="Herald Sun" title="Herald Sun" xmlUrl="https://www.heraldsun.com.au/help-rss" htmlUrl="http://heraldsun.com.au" description="The Herald Sun is one of the biggest-selling newspapers with a proud history of leading the advocating and agenda for Victorians." />
            <outline type="rss" text="SBS Australia" title="SBS Australia" xmlUrl="https://www.sbs.com.au/news/feeds" htmlUrl="http://sbs.com.au" description="The Special Broadcasting Service (SBS) is a hybrid-funded public online broadcasting network owned by the Australian government." />
            <outline type="rss" text="Brisbane Times" title="Brisbane Times" xmlUrl="https://www.heraldsun.com.au/rss" htmlUrl="http://brisbanetimes.com.au" description="Brisbane Times is a news online publication that offers information covering areas of sports, lifestyles, entertainment, technology, business, and travel." />
