{
  "name": "cronos",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "bun run setup:app",
    "bootstrap:full": "bun run setup:app && bun run setup:catalog",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@cronos/api --filter=@cronos/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean --force && rm -rf node_modules",
    "prepare": "husky || true",
    "docker:up": "docker compose -f docker/docker-compose.yml --project-directory docker up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --project-directory docker down",
    "docker:restart": "docker compose -f docker/docker-compose.yml --project-directory docker restart",
    "docker:logs": "docker compose -f docker/docker-compose.yml --project-directory docker logs -f",
    "docker:ps": "docker compose -f docker/docker-compose.yml --project-directory docker ps",
    "docker:pull": "docker compose -f docker/docker-compose.yml --project-directory docker pull",
    "docker:build": "docker compose -f docker/docker-compose.yml --project-directory docker build",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:pull": "bun run --cwd packages/db db:pull",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:seed:feeds": "bun run catalog:import",
    "setup:app": "bun run docker:up && bun run db:migrate",
    "setup:catalog": "bun run catalog:sync",
    "catalog:install": "bun run --cwd packages/sangam install",
    "catalog:export": "bun run --cwd packages/sangam export:catalog",
    "catalog:import": "bun run --cwd apps/api catalog:import",
    "catalog:smoke": "bun run --cwd apps/api catalog:smoke",
    "catalog:sync": "bun run catalog:export && bun run catalog:import && bun run catalog:smoke",
    "catalog:sync:local": "bun run --cwd packages/sangam sync"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260418.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "turbo": "^2.9.6"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "nitro": "npm:nitro-nightly@latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "bunx oxfmt"
    ],
    "apps/api/src/**/*.{ts,tsx}": [
      "bunx oxlint --fix"
    ]
  }
}
