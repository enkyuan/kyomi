#!/usr/bin/env sh

if command -v bun >/dev/null 2>&1; then
  BUN_BIN="bun"
elif [ -n "$BUN_INSTALL" ] && [ -x "$BUN_INSTALL/bin/bun" ]; then
  BUN_BIN="$BUN_INSTALL/bin/bun"
elif [ -x "/opt/homebrew/bin/bun" ]; then
  BUN_BIN="/opt/homebrew/bin/bun"
else
  echo "bun is required to run Kyomi git hooks." >&2
  exit 127
fi

# git feeds the refs being pushed on stdin; check:env scans the env files those commits added as well
# as the current index, so plaintext that a later commit encrypted is still caught.
"$BUN_BIN" run check:env --pre-push
