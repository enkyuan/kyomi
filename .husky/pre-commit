#!/usr/bin/env sh

if command -v bun >/dev/null 2>&1; then
  BUN_BIN="bun"
elif [ -n "$BUN_INSTALL" ] && [ -x "$BUN_INSTALL/bin/bun" ]; then
  BUN_BIN="$BUN_INSTALL/bin/bun"
elif [ -x "/opt/homebrew/bin/bun" ]; then
  BUN_BIN="/opt/homebrew/bin/bun"
else
  echo "bun is required to run Kyomi git hooks." >&2
  exit 127
fi

# Only run dotenvx precommit when a .env* file is actually staged.
# dotenvx scans `git diff HEAD` (staged + unstaged), so unrelated dirty
# .env files in a multi-agent workspace would otherwise block every commit.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '(^|/)\.env($|\.)'; then
  "$BUN_BIN" run check:env
fi

"$BUN_BIN" x lint-staged
