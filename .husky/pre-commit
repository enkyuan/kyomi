#!/usr/bin/env sh

if command -v bun >/dev/null 2>&1; then
  BUN_BIN="bun"
elif [ -n "$BUN_INSTALL" ] && [ -x "$BUN_INSTALL/bin/bun" ]; then
  BUN_BIN="$BUN_INSTALL/bin/bun"
elif [ -x "/opt/homebrew/bin/bun" ]; then
  BUN_BIN="/opt/homebrew/bin/bun"
else
  echo "bun is required to run Kyomi git hooks." >&2
  exit 127
fi

# check:env reads the staged content of every tracked env-like file from the index, so unrelated
# dirty .env files in a multi-agent workspace cannot block a commit. It runs on every commit instead of
# only when a .env* path is staged: matching staged names here needed -z handling for non-ASCII paths and
# a second copy of the file-name rules, and a skipped check is how plaintext reaches a commit.
"$BUN_BIN" run check:env

"$BUN_BIN" x lint-staged
