# Use a simple, undotted name for the local Postgres database.
POSTGRES_DB=kyomi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432
# Host-side tools (db:migrate, api dev on the host). Optional if POSTGRES_* is set.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/kyomi
REDIS_URL=redis://localhost:6379

REDIS_PORT=6379

GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902

MEILI_PORT=7700
MEILI_MASTER_KEY=vols-meili-dev-key

API_PORT=8000

WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=a7324a983ce0ed18c033d38800b184b5308db076cca4f1fd47cd6dfc0ce78317
BETTER_AUTH_URL=http://localhost:3000

# Email OTP and password-reset delivery for the Docker API service. Leave both
# unset to log one-time codes locally; set both to enable Resend delivery.
AUTH_EMAIL_FROM=
RESEND_API_KEY=

LOG_LEVEL=info
FEED_ADMIN_USER_IDS=
MEILI_INDEX_FEEDS=feeds
GLOBAL_FEED_REFRESH_ENABLED=true
GLOBAL_FEED_REFRESH_BATCH_SIZE=10
GLOBAL_FEED_REFRESH_MAX_QUEUED=25
