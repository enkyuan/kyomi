# Public origin serving Kyomi's Better Auth endpoints (omit the trailing slash).
#
# For local iOS development, the app defaults to http://localhost:3000.
# For the Android emulator, it defaults to http://10.0.2.2:3000.
# Set an HTTPS URL for development-build OAuth and password-reset deep-link testing.
# Release builds reject non-HTTPS authentication origins.
# EXPO_PUBLIC_AUTH_ORIGIN=https://kyomi.example.com
