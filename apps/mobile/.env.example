# Optional public origin serving Kyomi's Better Auth endpoints (omit the trailing slash).
#
# Without this value, local iOS development defaults to http://localhost:8000.
# The Android emulator defaults to http://10.0.2.2:8000.
# Set an HTTPS URL for development-build OAuth and password-reset deep-link testing.
# Release builds reject non-HTTPS authentication origins.
# EXPO_PUBLIC_AUTH_ORIGIN=https://kyomi.example.com
