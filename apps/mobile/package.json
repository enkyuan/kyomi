{
  "name": "@kyomi/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_AUTH_ORIGIN=\"http://$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0):8000\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0)\" EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo start",
    "start:tunnel": "EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo start --tunnel",
    "android": "EXPO_PUBLIC_AUTH_ORIGIN=\"http://$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0):8000\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0)\" EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo run:android",
    "ios": "EXPO_PUBLIC_AUTH_ORIGIN=\"http://$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0):8000\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0)\" EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo run:ios",
    "ios:device": "EXPO_PUBLIC_AUTH_ORIGIN=\"http://$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0):8000\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(ipconfig getifaddr en9 2>/dev/null || ipconfig getifaddr en0)\" EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo run:ios --device",
    "web": "EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo start --web",
    "build": "EXPO_NO_DOTENV=1 bunx --no-install dotenvx run -f .env.local -fk .env.keys --ignore=MISSING_ENV_FILE -- expo export --platform all --output-dir dist",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
    "@callstack/liquid-glass": "^0.8.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "~57.0.26",
    "@kyomi/reader": "workspace:*",
    "@kyomi/ui": "workspace:*",
    "@kyomi/worker": "workspace:*",
    "@legendapp/list": "^3.3.3",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "better-auth": "1.6.25",
    "expo": "~57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.24",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "katex": "^0.16.45",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-fetch": "^1.6.3",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "deslop/unused-file",
        "deslop/unused-export"
      ],
      "overrides": [
        {
          "files": [
            "dist/**"
          ],
          "rules": [
            "react-doctor/artifact-secret-leak"
          ]
        },
        {
          "files": [
            "package.json"
          ],
          "rules": [
            "react-doctor/expo-no-redundant-dependency"
          ]
        },
        {
          "files": [
            "modules/header/src/**",
            "modules/screen-shape/src/**"
          ],
          "rules": [
            "unicorn/filename-case"
          ]
        },
        {
          "files": [
            "src/components/ui/tab-bar/**"
          ],
          "rules": [
            "react-doctor/react-compiler-no-manual-memoization"
          ]
        },
        {
          "files": [
            "src/components/ui/toast/atoms/viewport.tsx"
          ],
          "rules": [
            "eslint/complexity"
          ]
        },
        {
          "files": [
            "src/modules/inbox/components/list/index.tsx"
          ],
          "rules": [
            "react-doctor/rn-scrollview-dynamic-padding"
          ]
        },
        {
          "files": [
            "src/components/ui/search-field/atoms/index.tsx",
            "src/modules/auth/email/screen.tsx"
          ],
          "rules": [
            "react-hooks-js/immutability"
          ]
        },
        {
          "files": [
            "src/modules/auth/email/screen.ios.tsx",
            "src/modules/inbox/hooks/use-articles.ts",
            "src/modules/reader/screen.tsx",
            "src/modules/recents/components/list.tsx",
            "src/modules/recents/screen.tsx"
          ],
          "rules": [
            "react-doctor/react-compiler-no-manual-memoization"
          ]
        },
        {
          "files": [
            "src/modules/auth/email/screen.android.tsx"
          ],
          "rules": [
            "react-hooks-js/refs"
          ]
        }
      ]
    }
  }
}
