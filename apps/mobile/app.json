{
  "expo": {
    "scheme": "kyomi",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "Kyomi",
    "slug": "kyomi",
    "experiments": {
      "reactCompiler": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "android": {
      "package": "com.anonymous.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.mobile",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    }
  }
}
