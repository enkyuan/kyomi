{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["uniwind/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@icons": ["./src/components/icons/*"],
      "@modules/*": ["./src/modules/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@ui/*": ["./src/components/ui/*"],
      "@utils/*": ["./src/utils/*"],
      "@kyomi/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
