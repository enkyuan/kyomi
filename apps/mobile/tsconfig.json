{
  "extends": "expo/tsconfig.base",
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "dist"
  ],
  "compilerOptions": {
    "strict": true,
    "types": ["uniwind/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@ui/*": ["./src/components/ui/*"],
      "@kyomi/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
