{
  "name": "@kyomi/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "build": "bun build --compile src/main.tsx --outfile dist/kyomi",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@kyomi/reader": "workspace:*",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@kyomi/tsconfig": "workspace:*",
    "@types/react": "^19.2.0"
  }
}
