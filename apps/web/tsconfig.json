{
  "extends": "../../packages/tsconfig/web.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@integrations/*": ["./src/integrations/*"],
      "@lib/*": ["./src/lib/*"],
      "@utils/*": ["./src/utils/*"],
      "@kyomi/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["vite/client", "bun"]
  }
}
