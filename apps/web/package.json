{
  "name": "@kyomi/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite dev --port 3000",
    "build": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite build",
    "start": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- bun .output/server/index.mjs",
    "preview": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite preview",
    "fmt": "oxfmt src vite.config.ts sw.plugin.ts",
    "fmt:check": "oxfmt --check src vite.config.ts sw.plugin.ts",
    "lint": "oxlint src vite.config.ts sw.plugin.ts",
    "lint:fix": "oxlint --fix src vite.config.ts sw.plugin.ts",
    "routes:generate": "node scripts/generate-route-tree.mjs",
    "typecheck": "bun run routes:generate && tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kyomi/reader": "workspace:*",
    "@kyomi/ui": "workspace:*",
    "@kyomi/worker": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@posthog/react": "^1.10.4",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.1",
    "nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
    "posthog-js": "^1.418.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "agentation": "^3.0.2",
    "dotenv": "^17.4.2",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "reactDoctor": {
    "ignore": {
      "overrides": [
        {
          "files": [
            ".output/**"
          ],
          "rules": [
            "react-doctor/dangerous-html-sink",
            "react-doctor/insecure-crypto-risk",
            "react-doctor/mcp-tool-capability-risk",
            "react-doctor/request-body-mass-assignment",
            "react-doctor/unsafe-json-in-html"
          ]
        },
        {
          "files": [
            "src/routeTree.gen.ts"
          ],
          "rules": [
            "unicorn/filename-case"
          ]
        },
        {
          "files": [
            "src/modules/inbox/components/list/index.tsx"
          ],
          "rules": [
            "react-doctor/prefer-tag-over-role"
          ]
        },
        {
          "files": [
            "src/modules/sidebar/components/feed-favicon.tsx"
          ],
          "rules": [
            "react-doctor/no-adjust-state-on-prop-change"
          ]
        },
        {
          "files": [
            "src/modules/folders/components/feeds/index.tsx",
            "src/modules/folders/components/recap/expanded.tsx",
            "src/modules/inbox/components/recap/index.tsx",
            "src/modules/inbox/page.tsx"
          ],
          "rules": [
            "react-doctor/no-giant-component",
            "eslint/complexity",
            "eslint/max-lines"
          ]
        },
        {
          "files": [
            "src/routes/-guards.ts"
          ],
          "rules": [
            "react-doctor/clickjacking-redirect-risk"
          ]
        }
      ]
    }
  }
}
