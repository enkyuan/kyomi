{
  "name": "@kyomi/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite dev --port 3000",
    "build": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite build",
    "start": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- bun .output/server/index.mjs",
    "preview": "bunx --no-install dotenvx run -f ../../docker/.env -f .env -- vite preview",
    "fmt": "oxfmt src vite.config.ts sw.plugin.ts",
    "fmt:check": "oxfmt --check src vite.config.ts sw.plugin.ts",
    "lint": "oxlint src vite.config.ts sw.plugin.ts",
    "lint:fix": "oxlint --fix src vite.config.ts sw.plugin.ts",
    "routes:generate": "node scripts/generate-route-tree.mjs",
    "typecheck": "bun run routes:generate && tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@kyomi/reader": "workspace:*",
    "@kyomi/ui": "workspace:*",
    "@kyomi/worker": "workspace:*",
    "@mingcute/react": "^1.1.8",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@posthog/react": "^1.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.19",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.34",
    "@tanstack/react-virtual": "^3.13.23",
    "better-auth": "^1.5.3",
    "cmdk": "^1.1.1",
    "figma-squircle": "^1.1.0",
    "motion": "^12.38.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
    "posthog-js": "^1.358.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "agentation": "^3.0.2",
    "dotenv": "^17.3.1",
    "react-grab": "^0.1.34",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "reactDoctor": {
    "ignore": {
      "overrides": [
        {
          "files": [
            ".output/**"
          ],
          "rules": [
            "react-doctor/dangerous-html-sink",
            "react-doctor/insecure-crypto-risk",
            "react-doctor/mcp-tool-capability-risk",
            "react-doctor/request-body-mass-assignment"
          ]
        },
        {
          "files": [
            "src/routeTree.gen.ts"
          ],
          "rules": [
            "unicorn/filename-case"
          ]
        },
        {
          "files": [
            "src/modules/inbox/components/list/index.tsx"
          ],
          "rules": [
            "react-doctor/prefer-tag-over-role"
          ]
        },
        {
          "files": [
            "src/modules/sidebar/components/feed-favicon.tsx"
          ],
          "rules": [
            "react-doctor/no-adjust-state-on-prop-change"
          ]
        },
        {
          "files": [
            "src/modules/folders/components/feeds/index.tsx",
            "src/modules/folders/components/recap/expanded.tsx",
            "src/modules/inbox/components/recap/index.tsx",
            "src/modules/inbox/page.tsx"
          ],
          "rules": [
            "react-doctor/no-giant-component",
            "eslint/complexity",
            "eslint/max-lines"
          ]
        }
      ]
    }
  }
}
