# Copy to `.env.local` (preferred) or `.env` in this directory (`apps/web/`).
# See apps/web/README.md for Better Auth and PostHog setup.

# Required for Drizzle + Better Auth persistence
# DATABASE_URL=postgresql://postgres:admin@localhost:5432/cronos

# Better Auth — generate with: bunx --bun @better-auth/cli secret
# BETTER_AUTH_SECRET=

# Public origin of this app (omit trailing slash). Dev default in code: http://localhost:5173
# BETTER_AUTH_URL=http://localhost:5173

# Optional fallback for app URL (used if BETTER_AUTH_URL is unset)
# SERVER_URL=http://localhost:5173

# Optional — client-side analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
