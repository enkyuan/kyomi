# Copy to `.env.local` (preferred) or `.env` in this directory (`apps/web/`).
# See apps/web/README.md for Better Auth and PostHog setup.

# Public origin of this app (omit trailing slash)
# SERVER_URL=http://localhost:3000

# Required backend origin for auth and feed-reader API requests
# API_ORIGIN=http://localhost:8000

# Optional — client-side analytics
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
