# Copy to `.env` in this directory (`apps/api/`).
#
# `bun run dev` loads `../../docker/.env` first, then this file (later wins).
# Keep shared infra values (POSTGRES_*, MEILI_MASTER_KEY, BETTER_AUTH_SECRET, …) in
# `docker/.env`. Use this file for host-side connection URLs when the API runs outside
# Docker and talks to the local compose stack on localhost.
#
# Database name: use `vols_rss` (or similar), not `kyomi` — dots are invalid in
# unquoted Postgres identifiers and are awkward in connection URLs.

# --- Required (host dev; omit if set in docker/.env) ---

DATABASE_URL=postgresql://postgres:admin@localhost:5432/vols_rss
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# --- Optional ---

# PORT=8000
# NODE_ENV=development

# Defaults to WEB_ORIGIN when unset
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# DATABASE_SSL_MODE=disable

# LOG_LEVEL=info
# OPENAPI_ENABLED=true

# Discover / feed search (local Meilisearch from docker compose)
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=vols-meili-dev-key
# MEILI_INDEX_FEEDS=feeds

# Comma-separated Better Auth user ids for feed admin routes
# FEED_ADMIN_USER_IDS=

# Backup admin header: x-feed-admin-secret
# FEED_ADMIN_SHARED_SECRET=

# Global catalog refresh for the All inbox view. Defaults to enabled outside production.
# GLOBAL_FEED_REFRESH_ENABLED=true
# GLOBAL_FEED_REFRESH_BATCH_SIZE=10
# GLOBAL_FEED_REFRESH_MAX_QUEUED=25

# Tests only — do not use in production
# SKIP_ENV_VALIDATION=true
