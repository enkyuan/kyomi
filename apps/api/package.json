{
  "name": "@cronos/api",
  "version": "1.0.50",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "test": "bun test src",
    "dev": "bun --env-file=../../docker/.env --env-file=.env --watch src/app/dev.ts",
    "start": "bun --env-file=../../docker/.env --env-file=.env src/app/entry.ts",
    "worker": "bun --env-file=../../docker/.env --env-file=.env src/app/worker.ts",
    "catalog:import": "bun --env-file=../../docker/.env --env-file=.env src/scripts/import-catalog-feeds.ts --input ../../packages/sangam/processing/exports/catalog-feeds.jsonl",
    "catalog:smoke": "bun --env-file=../../docker/.env --env-file=.env src/scripts/smoke-discover-catalog.ts --query \"hacker news\" --expect \"hacker news\"",
    "fmt": "bunx oxfmt src",
    "fmt:check": "bunx oxfmt --check src",
    "lint": "bunx oxlint src",
    "lint:fix": "bunx oxlint --fix src",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cronos/sanitization": "workspace:*",
    "@cronos/db": "workspace:*",
    "@cronos/favicon": "workspace:*",
    "@cronos/ingestion": "workspace:*",
    "@cronos/worker": "workspace:*",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "0.34.48",
    "@t3-oss/env-core": "^0.13.10",
    "@typescript/native-preview": "^7.0.0-dev.20260309.1",
    "better-auth": "^1.5.3",
    "dompurify": "^3.4.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "1.4.27",
    "fast-xml-parser": "^5.5.10",
    "ioredis": "^5.6.0",
    "jsdom": "^29.0.2",
    "linkedom": "^0.18.12",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/mozilla-readability": "^0.2.1",
    "@types/pg": "^8.15.5",
    "bun-types": "latest"
  }
}
