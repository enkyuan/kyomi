#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="030408aca273c102cba72622779d22930f8eb70142c64a63abba90424b4ace076c"

# .env
# Copy to `.env` in this directory (`apps/api/`).
#
# `bun run dev` loads `../../docker/.env` first, then this file (later wins).
# Keep shared infra values (POSTGRES_*, MEILI_MASTER_KEY, BETTER_AUTH_SECRET, …) in
# `docker/.env`. Use this file for host-side connection URLs when the API runs outside
# Docker and talks to the local compose stack on localhost.
#
# Database name: use `kyomi` for local dev; avoid dotted names because they are
# awkward in unquoted Postgres identifiers and connection URLs.
#
# Commented lines show the built-in default — uncomment only to override. Values are
# validated at boot by `src/config/env/runtime.ts`; a bad/missing required value fails fast.

# --- Required (host dev; omit if set in docker/.env) ---

# Host-side Postgres URL. Matches docker/.env POSTGRES_* (user:password@host:port/db).
DATABASE_URL=encrypted:BND27im4cQYWHeqsta96SvtqITcu7ParaEOeg+coDTQ2wu0vCtfovuXWZ4WE2uFFONQdKOugGov3MrmBW8NW2rIWwN+dnsv6AcCMyCOZ7i32HT6eJVa8hIXWbXsVbG7FDI7FqHFxe0eVXHX7pqpg4yqG0wKKYk4WjTAmu5G2fUUsXOlJkhCzxIJeGrxh7KkeFA==
# Redis is used for the feed-refresh/OPML job streams.
REDIS_URL=encrypted:BKPKqdRgVLv+Jy/+y/Mhm6YXEZKgtW3GtXYxrQ4dNVpZDcefnraS+zg7oF3YsIoDSVgXrW1y+AEoLIlQOmNCL+A5U3tThhpSltMzgIx/2HmAU2/Or8SgBfFYg4UnJP2RfEL4uRND4qtQzRPEtjyEd0PrOChtxOY=
# Origin of the web app; also the default for auth URLs and CORS/trusted origins below.
WEB_ORIGIN=encrypted:BFMn5YePfHp+CJ3bnCyqJbs5ssQ6i4Bt1JHmhxzwAyV4LiGAcX5+4GctPZ2nzstsBXk1Yakx4faxuY7nlFwOJ8Bo51RO0z8pLKTm+hZMxRpfD8OSsI/nH05RzjJA2fFpH2M5+dqQa7V2ZhbP9OFY6ov9+WTJLQ==
# Signing secret for Better Auth sessions. Use a long random string; never commit a real one.
BETTER_AUTH_SECRET=encrypted:

# --- Optional ---

# HTTP port the API listens on.
# PORT=8000
# Runtime mode: development | production | test. Controls prod-only guards and defaults.
# NODE_ENV=development

# Better Auth base URL and the origins allowed to hold a session.
# Both default to WEB_ORIGIN when unset; set them only when auth runs on a different host.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Postgres connection pool tuning (per API process). Raise MAX under heavy concurrency.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# TLS to Postgres: disable (local) | require | no-verify (self-signed). Omit for no SSL.
# DATABASE_SSL_MODE=disable

# Log verbosity: info | warn | error.
# LOG_LEVEL=info
# Serve the OpenAPI docs endpoint. Defaults on outside production, off in production.
# OPENAPI_ENABLED=true

# Discover / feed search. Points at the local Meilisearch from docker compose.
# Leave MEILI_URL unset to disable search entirely (feed discovery falls back to Postgres).
# MEILI_MASTER_KEY must match docker/.env; MEILI_INDEX_FEEDS is the index name to use.
# MEILI_URL=http://localhost:7700
# MEILI_MASTER_KEY=kyomi-meili-dev-key
# MEILI_INDEX_FEEDS=feeds

# Embedding-based article classifier (Voyage AI). Leave unset to run feed refresh with only
# the deterministic keyword classifier -- no FEATURE_* flag gates this, same "absent means
# fall back" shape as MEILI_URL above. Get a key at https://dashboard.voyageai.com.
# VOYAGE_API_KEY=
# Category read-path gate: keyword keeps current behavior; embedding ranks embedding rows
# ahead of keyword rows while still falling back to keyword. Flip only after eval/reporting.
# CATEGORY_CLASSIFIER_READ_MODE=keyword

# Feed admin controls. Comma-separated Better Auth user ids allowed to call the admin
# feed routes (PUT|DELETE /feeds/:id/admin).
# FEED_ADMIN_USER_IDS=

# Fallback admin auth: shared secret accepted in the `x-feed-admin-secret` request header.
# FEED_ADMIN_SHARED_SECRET=

# Global catalog refresh for the All inbox view (background fan-out across all feeds).
# ENABLED defaults on outside production. BATCH_SIZE = feeds enqueued per tick;
# MAX_QUEUED caps in-flight refresh jobs so a large catalog can't flood the queue.
# GLOBAL_FEED_REFRESH_ENABLED=true
# GLOBAL_FEED_REFRESH_BATCH_SIZE=10
# GLOBAL_FEED_REFRESH_MAX_QUEUED=25

# --- Platform expansion (optional; all off by default) ---
#
# Each FEATURE_* flag gates one optional capability and defaults to false, so a fresh
# checkout runs with zero third-party credentials. A flag's credentials (in the block
# below) are required ONLY when that flag is enabled — e.g. turning on FEATURE_GOOGLE_OAUTH
# makes GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET mandatory; leaving it off keeps them
# optional. Enabling a flag without its credentials fails validation at boot.

# Google sign-in via Better Auth (needs GOOGLE_CLIENT_ID/SECRET).
# FEATURE_GOOGLE_OAUTH=false
# Register this callback URL with Google: ${BETTER_AUTH_URL}/api/auth/callback/google
# First-run onboarding flow.
# FEATURE_ONBOARDING=false
# Source connectors (public/app-credential only; no per-user OAuth in this roadmap).
# YouTube needs YOUTUBE_API_KEY; Reddit and X need their CLIENT_ID/SECRET.
# FEATURE_SOURCE_YOUTUBE=false
# FEATURE_SOURCE_REDDIT=false
# FEATURE_SOURCE_X=false
# AI article intelligence / knowledge banks (needs AI_PROVIDER + AI_API_KEY).
# FEATURE_AI_ARTICLE_INTELLIGENCE=false
# Opt-in social mode; reading stays private (zen) by default.
# FEATURE_SOCIAL_MODE=false
# Server-enriched reader link previews and Kyomi-owned share preview pages.
# FEATURE_LINK_PREVIEWS=false
# FEATURE_SHARE_PREVIEWS=false
# Public developer API surface under /api/public/v1 (see the settings below).
# FEATURE_PUBLIC_API=false
# Self-hosting / local appliance setup flow.
# FEATURE_SELF_HOSTING_SETUP=false

# Public developer API settings (only relevant when FEATURE_PUBLIC_API is enabled).
# KEY_PREFIX is the non-secret prefix on issued keys (logs show prefix/id only).
# RATE_LIMIT_* are the default per-key quotas (per minute / per day).
# PUBLIC_API_KEY_PREFIX=kyomi_pk_
# PUBLIC_API_DEFAULT_RATE_LIMIT_PER_MINUTE=60
# PUBLIC_API_DEFAULT_RATE_LIMIT_PER_DAY=10000

# External credentials — set only when the matching FEATURE_* flag above is enabled.
# Obtain these from each provider's developer console; never commit real values.
# GOOGLE_CLIENT_ID=          # FEATURE_GOOGLE_OAUTH
# GOOGLE_CLIENT_SECRET=      # FEATURE_GOOGLE_OAUTH
# Email OTP and password reset email delivery via Resend. Leave both unset in
# local development; sign-in OTP codes and reset links are written to the API log
# instead. Configure both in production (or to test live email delivery in dev).
AUTH_EMAIL_FROM="encrypted:BHmYDfItr2PxmQRKHChVNyh3Dno5OsDNAAXUlod1txGNkCUkfZ0UuuyPPKiN8tLDLQ3/Q+KM63zQQFyfcGWsNmQNH7OQ/L7BIzhRqEY7doOiVWgEvHMmne5xLq5iSxyvtalvKgCff3o+8JkW4D07u4GTrStHOWQzfZOGDzrK"
RESEND_API_KEY=encrypted:BL3t+uqz7Xx4hNjrp+IlZfvy8dApR4iLz6PiUTsSflt21qdkCZbKyQXlWC1e1zAqzQ5ldzlQ+fNmxV7XHhl5P6QP224TXolpUlVlPMbBI+mO6H2GvGwOra8Xd4fLJSaGU8jUFvofWJHVXb9FOyt4Bs4Pf6I7RbFFHhw7rDOyiKyodkB2Tg==
# YOUTUBE_API_KEY=           # FEATURE_SOURCE_YOUTUBE
# REDDIT_CLIENT_ID=          # FEATURE_SOURCE_REDDIT
# REDDIT_CLIENT_SECRET=      # FEATURE_SOURCE_REDDIT
# X_CLIENT_ID=               # FEATURE_SOURCE_X
# X_CLIENT_SECRET=           # FEATURE_SOURCE_X
# AI_PROVIDER=               # FEATURE_AI_ARTICLE_INTELLIGENCE (e.g. openai, ollama)
# AI_API_KEY=                # FEATURE_AI_ARTICLE_INTELLIGENCE

# Tests only — do not use in production. Bypasses env validation.
# SKIP_ENV_VALIDATION=true
