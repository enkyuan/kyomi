node_modules
dist
build
coverage
apps/*/bun.lock
packages/*/bun.lock
tests/bun.lock

# Dot files and folders: only what contributors need is tracked (.agents, .github, .husky,
# .circleci, .bun-version, .dockerignore, .oxfmtrc.json, .oxlintrc.json). Everything else
# starting with a dot is local, so new tools and caches need no entry here.
.*
!.agents/
!.circleci/
!.dockerignore
!.github/
!.gitignore
!.bun-version
!.husky/
!.oxfmtrc.json
!.oxlintrc.json
!.xcode.env

# Encrypted dotenvx files are tracked; their private keys and local overrides are not.
!.env
!.env.example
.env.keys
.env*.local

# Docker local overrides (corp CA mount, etc.)
docker/certs/
docker/docker-compose.override.yml

# Python pipeline artifacts
packages/catalog/**/__pycache__
packages/catalog/**/*.py[codz]
packages/catalog/processing/exports
packages/catalog/**/*.parquet
packages/catalog/**/*.duckdb
packages/catalog/**/*.db
