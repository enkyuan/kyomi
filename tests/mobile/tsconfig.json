{
  "extends": "../../packages/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../../apps/mobile/src/*"],
      "@modules/*": ["../../apps/mobile/src/modules/*"],
      "@hooks/*": ["../../apps/mobile/src/hooks/*"],
