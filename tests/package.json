{
  "name": "@kyomi/tests",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt api mobile web",
    "fmt:check": "oxfmt --check api mobile web",
    "lint": "oxlint api mobile web",
    "lint:fix": "oxlint --fix api mobile web",
    "typecheck": "tsc -p api/tsconfig.json --noEmit && tsc -p mobile/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "bun run test:api && bun run test:web && bun run test:mobile",
    "test:api": "bun run test:api:integration",
    "test:api:integration": "cd ../apps/api && bunx --no-install dotenvx run -f ../../docker/.env -f .env -- bun test --isolate ../../tests/api/integration",
    "test:api:e2e": "cd ../apps/api && bunx --no-install dotenvx run -f ../../docker/.env -f .env -- bun test --isolate ../../tests/api/e2e",
    "test:mobile": "bun run test:mobile:integration",
    "test:mobile:integration": "bun test mobile/integration",
    "test:web": "bun run test:web:integration",
    "test:web:integration": "vitest run --config web/vitest.config.ts",
    "test:web:e2e": "vitest run --config web/vitest.config.ts e2e"
  },
  "devDependencies": {
    "@kyomi/db": "workspace:*",
    "@kyomi/reader": "workspace:*",
    "@kyomi/ui": "workspace:*",
    "@kyomi/worker": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-router": "^1.92.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
